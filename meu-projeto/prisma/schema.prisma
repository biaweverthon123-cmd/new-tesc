generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model OrgaoTransitoIndividual {
  id                     Int      @id @default(autoincrement())
  codigo                 String   @unique
  razaoSocial            String   @map("razao_social")
  municipioUf            String   @map("municipio_uf")
  endereco               String
  cnpj                   String   @unique
  numero                 String
  imagemBrasaoMunicipio  String?  @map("imagem_brasao_municipio")
  criadoEm               DateTime @default(now()) @map("criado_em")
  atualizadoEm           DateTime @updatedAt @map("atualizado_em")

  @@map("transito_individual_orgaos")
}
